[Unit]
Description=Authorized Jego receiver %i
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=12
[Service]
Type=simple
WorkingDirectory=/opt/jego-research
Environment=JEGO_CREDENTIAL_FILE=/opt/jego-sms-control/accounts/%i/sdk-login-input.txt
Environment=JEGO_INFO_DIR=/opt/jego-sms-control/accounts/%i/info
Environment=JEGO_LOG_DIR=/opt/jego-sms-control/accounts/%i/log
Environment=JEGO_HEALTH_FILE=/opt/jego-sms-control/accounts/%i/receiver-health.json
ExecStart=/opt/jego-research/linux_sms_daemon /opt/jego-sms-control/accounts/%i/sdk-login-input.txt 0
Restart=always
RestartSec=120
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
LimitCORE=0
StandardOutput=append:/opt/jego-sms-control/accounts/%i/receiver.log
StandardError=append:/opt/jego-sms-control/accounts/%i/receiver.log
[Install]
WantedBy=multi-user.target
